@Library('my-shared-library') _

pipeline {
    agent any

    parameters{
        string(
            name: 'App_Version',
            defaultValue: '1.0',
            description: 'version of the application'
        )
    }

    stages{


        stage('Test shared Lib'){

            steps{

                slib1(
                    
                    app_name: 'Empower',
                    app_version: params.App_Version,
                    environment: 'dev'
                )

                
            }
        }

        stage('Nugenesis') {
            steps {
                slib1(
                    app_name: 'Nugenesis',
                    app_version: params.App_Version,
                    environment: 'prod'
                )
            }
        }


    }
    
}
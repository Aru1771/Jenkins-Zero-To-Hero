            steps{

               deployapp(
                app_name: "Empower",
                test_type: "integration"
               )

                
            }
        }

        stage('Nugenesis') {
            steps {
                deployapp(
                    app_name: "Nugenesis",
                    test_type: "unit"
                )
            }
        }


    }
    
}
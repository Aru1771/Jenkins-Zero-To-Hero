@Library('my-shared-library') _

pipeline {
    agent any

    parameters{
        string(
            name: 'App_Version',
            defaultValue: '1.0',
            description: 'version of the application'
        )

        choice(
            name: 'Deployment_Environment',
            choices: ['Production', 'Stage', 'Development'],
            description: 'Deployment environment of the application'
        )
    }

    stages{


        stage('Test shared Lib'){

            steps{

                buildApp(
                    app_name: 'Empower',
                    app_version: params.App_Version,
                    environment: params.Deployment_Environment
                )
            }
        }
        stage('Test cases') {

            steps{

                 runTests(
                    app_name: 'Nugenesis',
                    test_type: ' '

                 )

            }
        
        }

    }
    
}
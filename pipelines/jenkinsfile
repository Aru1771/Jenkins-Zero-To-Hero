@Library('my-shared-library') _

pipeline {
    agent any

    parameters{
        string(
            name: 'App_Version',
            defaultValue: '1.0',
            description: 'version of the application'
        )
    }

    stages{


        stage('Test shared Lib'){

            steps{

                buildApp(
                    app_name: 'Empower',
                    app_version: params.App_Version,
                )
            }
        }
        stage('Test cases') {

            steps{

                 runTests(
                    app_name: 'Nugenesis',
                    app_version: '2.0'

                 )

            }
        
        }

    }
    
}